# Official public read-only provider. This file must never contain a signer or wallet path.
MANGA_BOARD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
MANGA_BOARD_PROVIDER_LABEL=robinhood-official-public

# Private loopback dashboard. Access it through an SSH tunnel.
MANGA_BOARD_HOST=127.0.0.1
MANGA_BOARD_PORT=8788
# Default query path. Set to legacy only for an explicit rollback window; the
# append-only evidence ledger and SQLite database are retained either way.
MANGA_BOARD_READ_MODEL=sqlite

# Continuous discovery and bounded quote sweep.
MANGA_BOARD_SCAN_INTERVAL_MS=30000
MANGA_BOARD_MIN_CYCLE_PAUSE_MS=60000
MANGA_BOARD_CATALOG_INTERVAL_MS=300000
MANGA_BOARD_STALE_MS=180000
MANGA_BOARD_BATCH_SIZE=4
MANGA_BOARD_PRIORITY_REFRESH_SIZE=2
MANGA_BOARD_TOP_REFRESH_SIZE=4
MANGA_BOARD_QUOTE_CONCURRENCY=1
MANGA_BOARD_LEG_CONCURRENCY=5
MANGA_BOARD_CATALOG_CONCURRENCY=2
MANGA_BOARD_BLOCK_LAG=1
MANGA_BOARD_MIN_DEPTH_USD=100
# Probe cheaply on every selected candidate. A gross-positive probe or a
# previously actionable row expands to the full grid.
MANGA_BOARD_PROBE_AMOUNTS_USDG=5,10
MANGA_BOARD_AMOUNT_GRID_USDG=5,10,25,50,100
MANGA_BOARD_AMOUNT_QUOTE_CONCURRENCY=1
MANGA_BOARD_V3_SHORTLIST_SIZE=3
MANGA_BOARD_FULL_GRID_EVERY_CYCLES=0
MANGA_BOARD_FULL_GRID_REFRESH_MS=300000
MANGA_BOARD_OVERHEAD_GAS=100000
# Independent JSON-RPC calls retain their own responses while sharing bounded
# HTTP POSTs. A malformed/incomplete batch response permanently falls back to
# bounded individual requests until restart. POST counts are transport metrics,
# not provider billing units.
MANGA_BOARD_RPC_BATCH_SIZE=20
MANGA_BOARD_RPC_BATCH_WAIT_MS=10
MANGA_BOARD_RPC_HTTP_CONCURRENCY=1
MANGA_BOARD_RPC_LOGICAL_ATTEMPTS=3
MANGA_BOARD_RPC_RETRY_DELAY_MS=200

# Event-driven shadow wakeups use bounded HTTP eth_getLogs ranges. This is not
# a WebSocket subscription and it never signs or broadcasts. A low-frequency
# reconciliation cycle remains enabled through MANGA_BOARD_SCAN_INTERVAL_MS.
MANGA_BOARD_EVENT_POLL_MS=4000
MANGA_BOARD_EVENT_CONFIRMATIONS=2
MANGA_BOARD_EVENT_MAX_BLOCK_RANGE=2000
MANGA_BOARD_EVENT_WAKE_MAX_CANDIDATES=4
MANGA_BOARD_EVENT_V3_MAX_ADDRESSES=200
MANGA_BOARD_EVENT_REORG_LOOKBACK=12

# PoolManager Initialize-log backfill is durable and incremental. The default
# covers the observed PAIR launch era, not blocks before 45,000,000. Lower this
# only after benchmarking the provider; completeness is always reported from
# the configured start block rather than claimed for the whole chain.
MANGA_BOARD_CHAIN_CATALOG_START_BLOCK=45000000
MANGA_BOARD_CHAIN_CATALOG_BLOCK_RANGE=50000
MANGA_BOARD_CHAIN_CATALOG_BATCHES_PER_CYCLE=1

# LONG, Doppler and target-bound PoolManager attribution use independent durable
# cursors. Matching LONG/Doppler ranges share one bounded eth_getLogs request;
# the pool cursor never outruns either launch cursor. Coverage remains independent.
MANGA_BOARD_SOURCE_CATALOG_START_BLOCK=45000000
MANGA_BOARD_SOURCE_CATALOG_BLOCK_RANGE=50000
MANGA_BOARD_SOURCE_CATALOG_BATCHES_PER_CYCLE=1
