# Dedicated read-only provider. This file must never contain a signer or wallet path.
MANGA_BOARD_RPC_URL=https://read-only-provider.example/replace-me
MANGA_BOARD_PROVIDER_LABEL=reader-region

# Private loopback dashboard. Access it through an SSH tunnel.
MANGA_BOARD_HOST=127.0.0.1
MANGA_BOARD_PORT=8788

# Continuous discovery and bounded quote sweep.
MANGA_BOARD_SCAN_INTERVAL_MS=30000
MANGA_BOARD_CATALOG_INTERVAL_MS=300000
MANGA_BOARD_STALE_MS=180000
MANGA_BOARD_BATCH_SIZE=8
MANGA_BOARD_TOP_REFRESH_SIZE=8
MANGA_BOARD_QUOTE_CONCURRENCY=2
MANGA_BOARD_CATALOG_CONCURRENCY=6
MANGA_BOARD_BLOCK_LAG=1
MANGA_BOARD_MIN_DEPTH_USD=100
MANGA_BOARD_AMOUNT_USDG=10
MANGA_BOARD_OVERHEAD_GAS=50000
