[Unit]
Description=MANGA until-revoked dual-base watcher authorization
Wants=network-online.target manga-opportunity-board.service
After=network-online.target manga-opportunity-board.service
Conflicts=manga-chan-watcher.service manga-generic-watcher.service
OnFailure=manga-chan-alert@%n.service

[Service]
Type=oneshot
User=manga-chan-arb
Group=manga-chan-arb
SupplementaryGroups=manga-board
WorkingDirectory=/opt/manga-chan-arbitrage/current
EnvironmentFile=/etc/manga-chan-arbitrage/live.env
EnvironmentFile=-/etc/manga-chan-arbitrage/release.env
Environment=MANGA_RUN_DIR=/var/lib/manga-chan-arbitrage
Environment=MANGA_GENERIC_BOARD_SNAPSHOT=/run/manga-opportunity-board-feed/execution-snapshot.json
Environment=EARN_WATCH_ENABLED=1
Environment=EARN_WATCH_EVENT_POLL_MS=1000
Environment=EARN_WATCH_PERIODIC_MS=300000
Environment=EARN_LIVE_COARSE_PROBE_POINTS=8
Environment=EARN_LIVE_REFINEMENT_POINTS=6
Environment=EARN_LIVE_MIN_NET_WETH=0.000000000000000001
Environment=EARN_LIVE_MIN_HEADROOM_WETH=0
Environment=EARN_LIVE_MAX_FAILED_GAS_WETH=0.00012
Environment=EARN_LIVE_WALLET_RESERVE_WETH=0.00025
LoadCredentialEncrypted=manga-private-key:/etc/credstore.encrypted/manga-private-key
Environment=MANGA_PRIVATE_KEY_FILE=%d/manga-private-key
UMask=0077
# ExecStart-level values override an older live.env. Earn has no fixed principal
# cap; its authorization commits the balance-scaled sizing and Gas-solvency rules.
ExecStart=/usr/bin/env EARN_WATCH_ENABLED=1 EARN_WATCH_EVENT_POLL_MS=1000 EARN_WATCH_PERIODIC_MS=300000 EARN_LIVE_COARSE_PROBE_POINTS=8 EARN_LIVE_REFINEMENT_POINTS=6 EARN_LIVE_MIN_NET_WETH=0.000000000000000001 EARN_LIVE_MIN_HEADROOM_WETH=0 EARN_LIVE_MAX_FAILED_GAS_WETH=0.00012 EARN_LIVE_WALLET_RESERVE_WETH=0.00025 MANGA_GENERIC_WATCH_MIN_SCREENED_NET_USDG=0.05 npm run dual:watch:arm
StateDirectory=manga-chan-arbitrage
StateDirectoryMode=0700
MemoryMax=512M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/manga-chan-arbitrage
