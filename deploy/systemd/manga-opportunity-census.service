[Unit]
Description=MANGA signer-free Earn opportunity and competitor receipt census
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=manga-board
Group=manga-board
WorkingDirectory=/opt/manga-chan-arbitrage/current
Environment=MANGA_COMPETITOR_DATA_DIR=/var/lib/manga-opportunity-census
Environment=MANGA_COMPETITOR_BUSINESS_SNAPSHOT=/var/lib/manga-business-report/business-snapshot.json
Environment=MANGA_COMPETITOR_RETENTION_DAYS=7
Environment=MANGA_COMPETITOR_CHUNK_BLOCKS=20000
Environment=MANGA_COMPETITOR_SAFE_LAG_BLOCKS=5
Environment=MANGA_COMPETITOR_POLL_MS=15000
ExecStart=/usr/bin/env node scripts/earn-competitor-census.mjs watch
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20
KillSignal=SIGTERM
StateDirectory=manga-opportunity-census
StateDirectoryMode=0755
UMask=0027
MemoryHigh=96M
MemoryMax=128M
TasksMax=24
CPUQuota=20%
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/manga-opportunity-census

[Install]
WantedBy=multi-user.target
