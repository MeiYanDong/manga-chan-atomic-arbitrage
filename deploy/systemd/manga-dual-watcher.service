[Unit]
Description=MANGA until-revoked dual USDG/WETH autonomous arbitrage watcher
Wants=network-online.target manga-opportunity-board.service
After=network-online.target manga-opportunity-board.service
Conflicts=manga-chan-watcher.service manga-generic-watcher.service manga-generic-arm.service manga-generic-deploy.service
OnFailure=manga-critical-health.service
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=simple
User=manga-chan-arb
Group=manga-chan-arb
SupplementaryGroups=manga-board
WorkingDirectory=/opt/manga-chan-arbitrage/current
EnvironmentFile=/etc/manga-chan-arbitrage/live.env
EnvironmentFile=-/etc/manga-chan-arbitrage/release.env
Environment=MANGA_RUN_DIR=/var/lib/manga-chan-arbitrage
Environment=MANGA_GENERIC_BOARD_SNAPSHOT=/run/manga-opportunity-board-feed/execution-snapshot.json
Environment=MANGA_GLOBAL_UNIVERSE_PATH=/run/manga-opportunity-board-feed/global-universe.json
# Bound each Node process in this cgroup below the service ceiling. The unified
# watcher intentionally spawns exact Earn/Global children, so leaving V8 at its
# host-derived default can let one child consume the whole shared-host budget.
Environment=NODE_OPTIONS=--max-old-space-size=320
Environment=EARN_WATCH_ENABLED=1
Environment=EARN_WATCH_EVENT_POLL_MS=60000
Environment=EARN_WATCH_PERIODIC_MS=300000
Environment=EARN_MANAGED_FALLBACK_DAILY_LOGICAL_CALL_CAP=40000
Environment=GLOBAL_WATCH_ENABLED=1
Environment=GLOBAL_WATCH_MIN_INTERVAL_MS=15000
Environment=GLOBAL_WATCH_PERIODIC_MS=300000
Environment=GLOBAL_WATCH_CHILD_TIMEOUT_MS=60000
Environment=GLOBAL_SEARCH_READONLY_CATALOG=1
Environment=EARN_WATCH_CHILD_TIMEOUT_MS=60000
Environment=GLOBAL_MANAGED_FALLBACK_DAILY_LOGICAL_CALL_CAP=20000
Environment=EARN_LIVE_COARSE_PROBE_POINTS=8
Environment=EARN_LIVE_REFINEMENT_POINTS=6
Environment=EARN_LIVE_MIN_NET_WETH=0.000000000000000001
Environment=EARN_LIVE_MIN_HEADROOM_WETH=0
Environment=EARN_LIVE_MAX_FAILED_GAS_WETH=0.00012
Environment=EARN_LIVE_WALLET_RESERVE_WETH=0.00025
LoadCredentialEncrypted=manga-private-key:/etc/credstore.encrypted/manga-private-key
Environment=MANGA_PRIVATE_KEY_FILE=%d/manga-private-key
UMask=0077
# The ExecStart-level screen value wins over a retained live.env. Both the dual
# and Earn lanes still require their exact protected on-chain net-profit floors.
ExecStart=/usr/bin/env EARN_WATCH_ENABLED=1 EARN_WATCH_EVENT_POLL_MS=60000 EARN_WATCH_PERIODIC_MS=300000 EARN_WATCH_CHILD_TIMEOUT_MS=60000 EARN_MANAGED_FALLBACK_DAILY_LOGICAL_CALL_CAP=40000 GLOBAL_WATCH_ENABLED=1 GLOBAL_WATCH_MIN_INTERVAL_MS=15000 GLOBAL_WATCH_PERIODIC_MS=300000 GLOBAL_WATCH_CHILD_TIMEOUT_MS=60000 GLOBAL_SEARCH_READONLY_CATALOG=1 GLOBAL_MANAGED_FALLBACK_DAILY_LOGICAL_CALL_CAP=20000 EARN_LIVE_COARSE_PROBE_POINTS=8 EARN_LIVE_REFINEMENT_POINTS=6 EARN_LIVE_MIN_NET_WETH=0.000000000000000001 EARN_LIVE_MIN_HEADROOM_WETH=0 EARN_LIVE_MAX_FAILED_GAS_WETH=0.00012 EARN_LIVE_WALLET_RESERVE_WETH=0.00025 MANGA_GENERIC_WATCH_MIN_SCREENED_NET_USDG=0.05 node scripts/dual-base-arb.mjs watch
Restart=on-failure
RestartPreventExitStatus=70 71 72
RestartSec=5s
TimeoutStopSec=20
KillSignal=SIGTERM
StateDirectory=manga-chan-arbitrage
StateDirectoryMode=0700
MemoryHigh=448M
MemoryMax=512M
TasksMax=64
CPUWeight=200
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/manga-chan-arbitrage

[Install]
WantedBy=multi-user.target
