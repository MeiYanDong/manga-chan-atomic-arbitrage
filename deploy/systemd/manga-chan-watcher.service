[Unit]
Description=MANGA CHAN bounded atomic-arbitrage watcher
Wants=network-online.target
After=network-online.target
OnFailure=manga-chan-alert@%n.service

[Service]
Type=simple
User=manga-chan-arb
Group=manga-chan-arb
WorkingDirectory=/opt/manga-chan-arbitrage/current
EnvironmentFile=/etc/manga-chan-arbitrage/live.env
EnvironmentFile=-/etc/manga-chan-arbitrage/release.env
Environment=MANGA_RUN_DIR=/var/lib/manga-chan-arbitrage
LoadCredential=private-key:/etc/manga-chan-arbitrage/private-key
Environment=MANGA_PRIVATE_KEY_FILE=%d/private-key
UMask=0077
ExecStartPre=/usr/bin/npm run compile
ExecStart=/usr/bin/npm run watch
Restart=no
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/manga-chan-arbitrage

[Install]
WantedBy=multi-user.target
