[Unit]
Description=MANGA read-only multi-pool opportunity board
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=manga-board
Group=manga-board
WorkingDirectory=/opt/manga-chan-arbitrage/current
EnvironmentFile=/etc/manga-opportunity-board/live.env
Environment=MANGA_BOARD_RUN_DIR=/var/lib/manga-opportunity-board
UMask=0027
ExecStart=/usr/bin/env npm run board
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20
KillSignal=SIGTERM
StateDirectory=manga-opportunity-board
StateDirectoryMode=0750
MemoryMax=256M
TasksMax=48
CPUQuota=60%
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/manga-opportunity-board

[Install]
WantedBy=multi-user.target
