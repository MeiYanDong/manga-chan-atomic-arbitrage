{
  "name": "manga-chan-atomic-arbitrage",
  "version": "0.6.2",
  "description": "Bounded MANGA atomic-arbitrage executor and read-only multi-pool opportunity board on Robinhood Chain",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeiYanDong/manga-chan-atomic-arbitrage.git"
  },
  "bugs": {
    "url": "https://github.com/MeiYanDong/manga-chan-atomic-arbitrage/issues"
  },
  "homepage": "https://github.com/MeiYanDong/manga-chan-atomic-arbitrage#readme",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    ".env.example",
    ".prettierignore",
    ".solhint.json",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "contracts",
    "deploy",
    "deployments",
    "docs",
    "eslint.config.js",
    "hardhat.config.js",
    "prettier.config.mjs",
    "public",
    "reports",
    "scripts",
    "src",
    "test",
    "tsconfig.json",
    "ui",
    "vite.config.mjs"
  ],
  "scripts": {
    "compile": "node scripts/manga-chan-arb.mjs compile && node scripts/generic-contract-compile.mjs && node scripts/weth-contract-compile.mjs",
    "self-test": "node scripts/manga-chan-arb.mjs self-test",
    "test": "node --test --test-reporter=spec test/*.test.mjs",
    "test:contract": "node scripts/contract-test.mjs && node scripts/generic-contract-test.mjs && node scripts/weth-contract-test.mjs",
    "lint": "npm run lint:js && npm run lint:sol && npm run lint:shell",
    "lint:js": "eslint .",
    "lint:sol": "solhint 'contracts/**/*.sol' 'test/contracts/**/*.sol'",
    "lint:shell": "bash -n deploy/*.sh",
    "verify:systemd": "bash deploy/verify-systemd.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "secret:scan": "node scripts/secret-scan.mjs",
    "ui:dev": "vite --config vite.config.mjs",
    "ui:build": "vite build --config vite.config.mjs",
    "check": "npm run format:check && npm run lint && npm run verify:systemd && npm run typecheck && npm run ui:build && npm run compile && npm test && npm run test:contract && npm run secret:scan",
    "status": "node scripts/manga-chan-arb.mjs status",
    "runtime:verify": "node scripts/manga-chan-arb.mjs runtime-verify",
    "rpc:benchmark": "node scripts/benchmark-rpc.mjs",
    "deployment:recover": "node scripts/manga-chan-arb.mjs recover-deployment",
    "preflight": "node scripts/manga-chan-arb.mjs preflight",
    "execute": "node scripts/manga-chan-arb.mjs execute",
    "reconcile": "node scripts/manga-chan-arb.mjs reconcile",
    "withdraw": "node scripts/manga-chan-arb.mjs withdraw-all",
    "watch:arm": "node scripts/manga-chan-arb.mjs watch-arm",
    "watch": "node scripts/manga-chan-arb.mjs watch",
    "watch:status": "node scripts/manga-chan-arb.mjs watch-status",
    "watch:disarm": "node scripts/manga-chan-arb.mjs watch-disarm",
    "fork-test": "node scripts/manga-chan-arb.mjs fork-test",
    "fork-test:generic": "node scripts/generic-fork-test.mjs",
    "generic:plan": "node scripts/generic-arb.mjs plan",
    "generic:status": "node scripts/generic-arb.mjs status",
    "generic:runtime-verify": "node scripts/generic-arb.mjs runtime-verify",
    "generic:deploy-preflight": "node scripts/generic-arb.mjs deploy-preflight",
    "generic:deploy": "node scripts/generic-arb.mjs deploy",
    "generic:preflight": "node scripts/generic-arb.mjs preflight",
    "generic:execute": "node scripts/generic-arb.mjs execute",
    "generic:reconcile": "node scripts/generic-arb.mjs reconcile",
    "generic:withdraw": "node scripts/generic-arb.mjs withdraw-all",
    "generic:watch:arm": "node scripts/generic-arb.mjs watch-arm",
    "generic:watch": "node scripts/generic-arb.mjs watch",
    "generic:watch:status": "node scripts/generic-arb.mjs watch-status",
    "generic:watch:disarm": "node scripts/generic-arb.mjs watch-disarm",
    "dual:compile": "node scripts/dual-base-arb.mjs compile",
    "dual:plan": "node scripts/dual-base-arb.mjs plan",
    "dual:status": "node scripts/dual-base-arb.mjs status",
    "dual:runtime-verify": "node scripts/dual-base-arb.mjs runtime-verify",
    "dual:weth:deploy-preflight": "node scripts/dual-base-arb.mjs weth-deploy-preflight",
    "dual:weth:deploy": "node scripts/dual-base-arb.mjs weth-deploy",
    "dual:preflight": "node scripts/dual-base-arb.mjs preflight",
    "dual:execute": "node scripts/dual-base-arb.mjs execute",
    "dual:reconcile": "node scripts/dual-base-arb.mjs reconcile",
    "dual:weth:withdraw": "node scripts/dual-base-arb.mjs weth-withdraw-all",
    "dual:watch:arm": "node scripts/dual-base-arb.mjs watch-arm",
    "dual:watch": "node scripts/dual-base-arb.mjs watch",
    "dual:watch:status": "node scripts/dual-base-arb.mjs watch-status",
    "dual:watch:disarm": "node scripts/dual-base-arb.mjs watch-disarm",
    "board": "node scripts/opportunity-board.mjs watch",
    "board:once": "node scripts/opportunity-board.mjs once",
    "board:status": "node scripts/opportunity-board.mjs status",
    "board:catalog:compact": "node --expose-gc scripts/compact-source-catalog.mjs compact",
    "board:catalog:verify": "node --expose-gc scripts/compact-source-catalog.mjs verify"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solc": "0.8.26",
    "viem": "2.56.3"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "hardhat": "3.15.0",
    "prettier": "3.9.6",
    "solhint": "6.2.4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
