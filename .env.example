# A strategy-owned managed HTTP endpoint. Normally required for live commands;
# the explicit public fallback below is a degraded emergency exception.
MANGA_RPC_URL=https://provider.example/replace-me

# A strategy-owned managed WSS endpoint. Required for event-driven watch mode.
MANGA_WS_URL=wss://provider.example/replace-me

# Optional independent read endpoint used by reconcile. It must not alias MANGA_RPC_URL.
MANGA_READ_RPC_URL=https://independent-provider.example/replace-me
MANGA_PROVIDER_LABEL=provider-region

# macOS local signer. The service name is public metadata; the secret stays in Keychain.
MANGA_KEYCHAIN_SERVICE=codex-rh-manga-chan-20260904

# Linux signer. Point to a root-provisioned mode-0600 file or systemd credential.
# Never put the private key itself in this file.
# MANGA_PRIVATE_KEY_FILE=/run/credentials/manga-chan-watcher.service/private-key

# Linux runtime state belongs outside an immutable release directory.
# MANGA_RUN_DIR=/var/lib/manga-chan-arbitrage

# Polling-only mode exists for recovery drills, not production.
MANGA_ALLOW_POLLING_ONLY=0
# Emergency opt-in only. Robinhood's public RPC can broadcast but is rate-limited
# and explicitly not production-grade; the default live gate rejects it.
MANGA_ALLOW_PUBLIC_EXECUTION_RPC=0

# Generic-v2 reads the isolated board over loopback, then independently runs
# exact executor simulation and gas estimation before any signing command.
MANGA_GENERIC_BOARD_URL=http://127.0.0.1:8788/api/snapshot
# The supplied Linux services override the URL with this atomically replaced,
# group-readable projection so board computation cannot block signer discovery.
# MANGA_GENERIC_BOARD_SNAPSHOT=/run/manga-opportunity-board-feed/execution-snapshot.json
MANGA_GENERIC_MAX_QUOTE_AGE_MS=45000
MANGA_GENERIC_MIN_NET_USDG=0.1
MANGA_GENERIC_PROFIT_RETENTION_BPS=9500
MANGA_GENERIC_PREFLIGHT_CANDIDATES=6

# The generic watcher polls only the loopback board while idle. A new board
# opportunity must clear this screened-net gate before the managed RPC is used
# for one targeted exact preflight. It may be lower than the exact execution
# floor: the lower value spends read calls only and never lowers the signed net
# requirement. By default every arm has a bounded lease and
# independent limits for exact preflights, signed attempts, confirmed executions
# and failed gas.
# Rolling renewal is opt-in. It renews the lease inside the existing watcher only
# while every state/risk invariant still passes; it never creates a new risk epoch.
# UNTIL_REVOKED is mutually exclusive with rolling renewal. It removes only the
# time stop and lets confirmed retained USDG raise the eligible principal up to
# the immutable 100 USDG contract cap. Manual top-ups require a fresh arm.
MANGA_GENERIC_WATCH_POLL_MS=1000
MANGA_GENERIC_WATCH_ARM_HOURS=24
MANGA_GENERIC_WATCH_AUTO_RENEW=0
MANGA_GENERIC_WATCH_UNTIL_REVOKED=0
MANGA_GENERIC_WATCH_RENEW_BEFORE_HOURS=6
MANGA_GENERIC_WATCH_MAX_EXECUTIONS=5
MANGA_GENERIC_WATCH_MAX_PREFLIGHTS=24
MANGA_GENERIC_WATCH_MIN_SCREENED_NET_USDG=0.05
MANGA_GENERIC_WATCH_MAX_CONSECUTIVE_ERRORS=10

# Deployment defaults to zero principal. Set this explicitly only for a reviewed
# deployment; 0.01 ETH generally cannot capitalize the full 100 USDG ceiling.
MANGA_GENERIC_SEED_ETH=0
MANGA_GENERIC_MIN_ETH_RESERVE=0.002

# Dual-v3 adds a separate WETH-principal executor. The seed is native ETH that
# the constructor wraps 1:1; after deployment, native ETH remains in the wallet
# for Gas while WETH principal and profit stay inside the executor. The 1 WETH
# immutable cap permits future retained-profit growth without granting access to
# wallet funds. Zero is a fail-closed placeholder and deployment rejects it;
# set a positive seed explicitly only after a live deploy preflight.
MANGA_WETH_SEED_ETH=0
MANGA_WETH_MAX_AMOUNT_WETH=1
MANGA_WETH_MIN_GROSS_PROFIT_WETH=0.000001

# Dual autonomous mode is intentionally only available under the explicit
# until-revoked, unlimited-count policy. The finite failed-Gas breaker and all
# per-transaction net-profit, wallet-reserve, nonce, and contract caps remain.
# MANGA_GENERIC_WATCH_UNTIL_REVOKED=1
# MANGA_GENERIC_WATCH_MAX_EXECUTIONS=unlimited
# MANGA_GENERIC_WATCH_MAX_ATTEMPTS=unlimited
# MANGA_GENERIC_WATCH_MAX_PREFLIGHTS=unlimited
